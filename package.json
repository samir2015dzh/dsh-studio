{
  "name": "dsh-studio",
  "version": "1.2.0",
  "description": "Skill studio for DeepSeek Harness with self-improving pipeline: per-turn worth judgement, auto-accept into the skill library, semantic merging with category tags + model verdict + tombstone guard, and model calls routed through DSH (no stored API key).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "MCP.md",
    "STUDIO-BACKUP.md"
  ],
  "scripts": {
    "release": "node scripts/release.mjs --skip-npm",
    "release:check": "node scripts/release.mjs --check",
    "verify": "node scripts/portability.mjs --health /api/dsh-studio/list",
    "verify:full": "node scripts/portability.mjs --health /api/dsh-studio/list --stability 30",
    "verify:quick": "node scripts/portability.mjs --skip-audit --stability 5 --health /api/dsh-studio/list",
    "check:host-deps": "node scripts/check-host-deps.mjs",
    "check:host": "node scripts/check-host.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:parallel": "node --test \"tests/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check",
    "test:boot": "node tests/boot.test.mjs",
    "preinstall": "node scripts/guard-install.mjs",
    "guard:install": "node scripts/guard-install.mjs --check",
    "prepack": "node scripts/guard-install.mjs && node scripts/strip-lifecycle-for-pack.mjs --strip",
    "postpack": "node scripts/strip-lifecycle-for-pack.mjs --restore"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skills",
    "manager",
    "editor",
    "studio",
    "extract",
    "extractor",
    "session",
    "auto-extract",
    "semantic-merge",
    "dedupe",
    "auto-accept"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samir2015dzh/dsh-studio.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  },
  "homepage": "https://github.com/samir2015dzh/dsh-studio#readme"
}
